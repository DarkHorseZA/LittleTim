{
  "expo": {
    "name": "re-Genesis",
    "slug": "littletim",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "scheme": "littletim",
    "newArchEnabled": true,
    "icon": "./assets/brand/icon.png",
    "splash": {
      "image": "./assets/brand/icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#F5EFE6"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.littletim.app"
    },
    "android": {
      "package": "com.littletim.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/brand/icon.png",
        "backgroundColor": "#F5EFE6"
      }
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/brand/icon.png"
    },
    "experiments": {
      "baseUrl": "/LittleTim"
    }
  }
}
