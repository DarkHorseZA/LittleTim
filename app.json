{
  "expo": {
    "name": "re-Genesis",
    "slug": "re-genesis",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "scheme": "littletim",
    "icon": "./assets/brand/icon.png",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.theunispienaar.regenesis",
      "config": {
        "usesNonExemptEncryption": false
      },
      "infoPlist": {
        "UIBackgroundModes": ["audio"]
      }
    },
    "android": {
      "package": "com.theunispienaar.regenesis",
      "versionCode": 1,
      "permissions": [
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/brand/icon.png",
        "backgroundColor": "#F5EFE6"
      }
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/brand/icon.png"
    },
    "experiments": {
      "baseUrl": "/LittleTim"
    },
    "plugins": [
      "expo-asset",
      [
        "expo-splash-screen",
        {
          "image": "./assets/brand/icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#F5EFE6"
        }
      ],
      "expo-audio",
      "./plugins/withoutApsEnvironment"
    ],
    "extra": {
      "eas": {
        "projectId": "98c320ea-e677-469a-876d-1fbd7038cc6e"
      }
    }
  }
}
