{
  "expo": {
    "name": "re-Genesis",
    "slug": "re-genesis",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "scheme": "littletim",
    "newArchEnabled": true,
    "icon": "./assets/brand/icon.png",
    "splash": {
      "image": "./assets/brand/icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#F5EFE6"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.theunispienaar.regenesis",
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.theunispienaar.regenesis",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/brand/icon.png",
        "backgroundColor": "#F5EFE6"
      }
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/brand/icon.png"
    },
    "experiments": {
      "baseUrl": "/LittleTim"
    },
    "plugins": [
      "expo-asset",
      [
        "expo-build-properties",
        {
          "android": {
            "compileSdkVersion": 35,
            "targetSdkVersion": 35,
            "buildToolsVersion": "35.0.0"
          }
        }
      ],
      "expo-audio"
    ],
    "extra": {
      "eas": {
        "projectId": "98c320ea-e677-469a-876d-1fbd7038cc6e"
      }
    }
  }
}
